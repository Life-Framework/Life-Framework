   $faces {
     0 4 0 1 2 3
   }
   $faceVerts {
     2 0 0
     3 0 1
     1 0 2
     0 0 3
   }
   $verts {
     -0 -0.5 -2 0
     0 -0.5 2 0
     -0 0.5 -2 0
     0 0.5 2 0
   }
   $texCoords {
     0 0
     1 0
     1 1
     0 1
   }
   $normals {
     1 -0 -0
   }
  }
 }
}
