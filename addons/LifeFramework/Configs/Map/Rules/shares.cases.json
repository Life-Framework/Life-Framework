{
  "rule": "shares",
  "version": 1,
  "about": "The shared-mark rules (docs/architecture/everon-map.md section 3, 'Shared marks', card M9), in the loader format of tools/map/rules/index.mjs: cases = [{ name, input, expect }]. Run by LF_Test_MapShares (Enforce, LF_MapShareRules) and tools/validation/map-shares-selftest.mjs (node, evaluate() of tools/map/rules/shares.mjs): one table, so the two cannot drift. op audience: does a player with uid, roles (on-duty services only) and org receive a row for audience PLAYER|ROLE|ORG|EVERYONE and id; expect yes|no. op expired: is a row with expires (world seconds, 0 = never) gone at now; expect yes|no. op area: is a row's optional area drawable (radius metres 1 to 5000, style the LF_MapAreaStyle id 0 to 5; radius 0 is no area); expect yes|no. op diff: what a membership change sends, from the keys delivered to the keys wanted; expect 'add:<keys>|remove:<keys>' with keys comma-separated in order. Every input carries every field (the Enforce class reader fills members by name; radius and style are the area's), unused ones empty.",
  "cases": [
    { "name": "player row reaches its player", "input": { "op": "audience", "audience": "PLAYER", "id": "char-a", "uid": "char-a", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "yes" },
    { "name": "player row never reaches another player", "input": { "op": "audience", "audience": "PLAYER", "id": "char-a", "uid": "char-b", "roles": ["police"], "org": "crew", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "no" },
    { "name": "player row with no id reaches nobody (fail safe)", "input": { "op": "audience", "audience": "PLAYER", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "no" },
    { "name": "police row reaches an on-duty officer", "input": { "op": "audience", "audience": "ROLE", "id": "police", "uid": "char-a", "roles": ["police"], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "yes" },
    { "name": "police row never reaches an on-duty medic (D-M10)", "input": { "op": "audience", "audience": "ROLE", "id": "police", "uid": "char-a", "roles": ["medic"], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "no" },
    { "name": "police row never reaches an off-duty player", "input": { "op": "audience", "audience": "ROLE", "id": "police", "uid": "char-a", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "no" },
    { "name": "medic row reaches an on-duty medic", "input": { "op": "audience", "audience": "ROLE", "id": "medic", "uid": "char-a", "roles": ["medic"], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "yes" },
    { "name": "role row with no role named reaches nobody (fail safe)", "input": { "op": "audience", "audience": "ROLE", "id": "", "uid": "char-a", "roles": ["police"], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "no" },
    { "name": "org row reaches a member", "input": { "op": "audience", "audience": "ORG", "id": "crew", "uid": "char-a", "roles": [], "org": "crew", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "yes" },
    { "name": "org row never reaches another org", "input": { "op": "audience", "audience": "ORG", "id": "crew", "uid": "char-a", "roles": [], "org": "rivals", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "no" },
    { "name": "org row never reaches a player in no org", "input": { "op": "audience", "audience": "ORG", "id": "crew", "uid": "char-a", "roles": ["police"], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "no" },
    { "name": "org row with no org named never matches a player in no org (fail safe)", "input": { "op": "audience", "audience": "ORG", "id": "", "uid": "char-a", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "no" },
    { "name": "everyone row reaches a fresh player", "input": { "op": "audience", "audience": "EVERYONE", "id": "", "uid": "char-a", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "yes" },
    { "name": "an unknown audience reaches nobody", "input": { "op": "audience", "audience": "BOGUS", "id": "police", "uid": "char-a", "roles": ["police"], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "no" },
    { "name": "a row with no expiry never expires", "input": { "op": "expired", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 100000, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "no" },
    { "name": "a row before its expiry stays", "input": { "op": "expired", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 100, "now": 99.5, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "no" },
    { "name": "a row at its expiry goes", "input": { "op": "expired", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 100, "now": 100, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "yes" },
    { "name": "a row past its expiry goes", "input": { "op": "expired", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 100, "now": 150, "delivered": [], "wanted": [], "radius": 0, "style": 0 }, "expect": "yes" },
    { "name": "going on duty sends the service's rows", "input": { "op": "diff", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": ["dispatch:1", "dispatch:2"], "radius": 0, "style": 0 }, "expect": "add:dispatch:1,dispatch:2|remove:" },
    { "name": "going off duty removes them", "input": { "op": "diff", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": ["event:fair", "dispatch:1"], "wanted": ["event:fair"], "radius": 0, "style": 0 }, "expect": "add:|remove:dispatch:1" },
    { "name": "leaving one org for another swaps its rows", "input": { "op": "diff", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": ["org:crew:1"], "wanted": ["org:rivals:1"], "radius": 0, "style": 0 }, "expect": "add:org:rivals:1|remove:org:crew:1" },
    { "name": "no membership change sends nothing", "input": { "op": "diff", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": ["a", "b"], "wanted": ["a", "b"], "radius": 0, "style": 0 }, "expect": "add:|remove:" },
    { "name": "a row with no radius carries no area", "input": { "op": "area", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 0, "style": 5 }, "expect": "no" },
    { "name": "an event-style circle of 150 m is an area", "input": { "op": "area", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 150, "style": 5 }, "expect": "yes" },
    { "name": "the first style id (town) is drawable", "input": { "op": "area", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 40, "style": 0 }, "expect": "yes" },
    { "name": "the widest area, 5000 m, is allowed", "input": { "op": "area", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 5000, "style": 5 }, "expect": "yes" },
    { "name": "an area over 5000 m is refused", "input": { "op": "area", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 5001, "style": 5 }, "expect": "no" },
    { "name": "a negative radius is no area", "input": { "op": "area", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": -20, "style": 5 }, "expect": "no" },
    { "name": "a style id past the last is refused", "input": { "op": "area", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 150, "style": 6 }, "expect": "no" },
    { "name": "a negative style id is refused", "input": { "op": "area", "audience": "", "id": "", "uid": "", "roles": [], "org": "", "expires": 0, "now": 0, "delivered": [], "wanted": [], "radius": 150, "style": -1 }, "expect": "no" }
  ]
}
