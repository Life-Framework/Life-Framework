           }
          }
          ButtonWidgetClass "{CHAIR_BUY_BTN}" : "{51898FF369FE5EB8}UI/layouts/WidgetLibrary/Buttons/DialogButtonConfirm.layout" {
           Name "BuyChairButton"
           Slot LayoutSlot "{CHAIR_BTN_SLOT}" {
            Padding 10 0 0 0
           }
          }
         }
        }
        HorizontalLayoutWidgetClass "{TABLE_ROW}" {
         Slot LayoutSlot "{TABLE_SLOT}" {
          Padding 0 5 0 5
         }
         {
          TextWidgetClass "{TABLE_TEXT}" {
           Text "Table - $1000"
           "Font Size" 16
           Slot LayoutSlot "{TABLE_TEXT_SLOT}" {
            SizeMode Fill
            FillWeight 1
            VerticalAlign 1
           }
          }
          ButtonWidgetClass "{TABLE_BUY_BTN}" : "{51898FF369FE5EB8}UI/layouts/WidgetLibrary/Buttons/DialogButtonConfirm.layout" {
           Name "BuyTableButton"
           Slot LayoutSlot "{TABLE_BTN_SLOT}" {
            Padding 10 0 0 0
           }
          }
         }
        }
        HorizontalLayoutWidgetClass "{BED_ROW}" {
         Slot LayoutSlot "{BED_SLOT}" {
          Padding 0 5 0 5
         }
         {
          TextWidgetClass "{BED_TEXT}" {
           Text "Bed - $2000"
           "Font Size" 16
           Slot LayoutSlot "{BED_TEXT_SLOT}" {
            SizeMode Fill
            FillWeight 1
            VerticalAlign 1
           }
          }
          ButtonWidgetClass "{BED_BUY_BTN}" : "{51898FF369FE5EB8}UI/layouts/WidgetLibrary/Buttons/DialogButtonConfirm.layout" {
           Name "BuyBedButton"
