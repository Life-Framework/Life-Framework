FrameWidgetClass : "{E6B607B27BCC1477}UI/layouts/Menus/Dialogs/ConfigurableDialog.layout" {
 {
  VerticalLayoutWidgetClass "{FURNITURE_ROOT_LAYOUT}" {
   {
    TextWidgetClass "{FURNITURE_TITLE}" {
     Text "#EL-FurnitureShop_Open"
     "Font Size" 24
