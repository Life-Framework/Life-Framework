FrameWidgetClass : "{E6B607B27BCC1477}UI/layouts/Menus/Dialogs/ConfigurableDialog.layout" {
 {
  VerticalLayoutWidgetClass "{GARAGE_ROOT_LAYOUT}" {
   {
    TextWidgetClass "{GARAGE_TITLE}" {
     Text "#EL-Garage_Open"
     "Font Size" 24
     Slot LayoutSlot "{GARAGE_TITLE_SLOT}" {
      HorizontalAlign 1
      Padding 0 20 0 10
     }
    }
    HorizontalLayoutWidgetClass "{GARAGE_STORE_ROW}" {
     Slot LayoutSlot "{GARAGE_STORE_SLOT}" {
      Padding 20 10 20 10
     }
     {
      EditBoxWidgetClass "{GARAGE_VEHICLE_INPUT}" {
       Name "VehicleInput"
       "Placeholder text" "Enter vehicle type"
       Slot LayoutSlot "{GARAGE_INPUT_SLOT}" {
        SizeMode Fill
        FillWeight 1
       }
      }
      ButtonWidgetClass "{GARAGE_STORE_BTN}" : "{51898FF369FE5EB8}UI/layouts/WidgetLibrary/Buttons/DialogButtonConfirm.layout" {
       Name "StoreButton"
       Slot LayoutSlot "{GARAGE_STORE_BTN_SLOT}" {
        Padding 10 0 0 0
       }
      }
     }
    }
    ScrollLayoutWidgetClass "{GARAGE_SCROLL}" {
     Slot LayoutSlot "{GARAGE_SCROLL_SLOT}" {
      SizeMode Fill
      FillWeight 1
      Padding 20 10 20 10
     }
     {
      VerticalLayoutWidgetClass "{GARAGE_VEHICLE_LIST}" {
       Name "VehicleList"
      }
     }
    }
    ButtonWidgetClass "{GARAGE_CLOSE_BTN}" : "{0114A06AD44D49BD}UI/layouts/WidgetLibrary/Buttons/DialogButtonCancel.layout" {
     Name "CloseButton"
     Slot LayoutSlot "{GARAGE_CLOSE_SLOT}" {
      Padding 20 20 20 20
     }
    }
   }
  }
 }
}