FrameWidgetClass : "{E6B607B27BCC1477}UI/layouts/Menus/Dialogs/ConfigurableDialog.layout" {
 {
  VerticalLayoutWidgetClass "{GROUP_ROOT_LAYOUT}" {
   {
    TextWidgetClass "{GROUP_TITLE}" {
     Text "#EL-Group_Manage"
     "Font Size" 24
     Slot LayoutSlot "{GROUP_TITLE_SLOT}" {
      HorizontalAlign 1
      Padding 0 20 0 10
     }
    }
    HorizontalLayoutWidgetClass "{GROUP_CREATE_ROW}" {
     Slot LayoutSlot "{GROUP_CREATE_SLOT}" {
      Padding 20 10 20 10
     }
     {
      EditBoxWidgetClass "{GROUP_NAME_INPUT}" {
       Name "GroupNameInput"
       "Placeholder text" "Enter group name"
       Slot LayoutSlot "{GROUP_INPUT_SLOT}" {
        SizeMode Fill
        FillWeight 1
       }
      }
      ButtonWidgetClass "{GROUP_CREATE_BTN}" : "{51898FF369FE5EB8}UI/layouts/WidgetLibrary/Buttons/DialogButtonConfirm.layout" {
       Name "CreateButton"
       Slot LayoutSlot "{GROUP_CREATE_BTN_SLOT}" {
        Padding 10 0 0 0
       }
      }
     }
    }
    TextWidgetClass "{GROUP_MEMBERS}" {
     Name "MembersText"
     Text "Members:"
     "Font Size" 16
     Slot LayoutSlot "{GROUP_MEMBERS_SLOT}" {
      Padding 20 5 20 5
     }
    }
    TextWidgetClass "{GROUP_BANK}" {
     Name "BankText"
     Text "Group Bank: $0"
     "Font Size" 16
     Slot LayoutSlot "{GROUP_BANK_SLOT}" {
      Padding 20 5 20 10
     }
    }
    HorizontalLayoutWidgetClass "{GROUP_BANK_ROW}" {
     Slot LayoutSlot "{GROUP_BANK_SLOT_ROW}" {
      Padding 20 10 20 10
     }
     {
      EditBoxWidgetClass "{GROUP_AMOUNT_INPUT}" {
       Name "AmountInput"
       "Placeholder text" "Amount"
       Slot LayoutSlot "{GROUP_AMOUNT_SLOT}" {
        SizeMode Fill
        FillWeight 1
       }
      }
      ButtonWidgetClass "{GROUP_DEPOSIT_BTN}" : "{51898FF369FE5EB8}UI/layouts/WidgetLibrary/Buttons/DialogButtonConfirm.layout" {
       Name "DepositButton"
       Slot LayoutSlot "{GROUP_DEPOSIT_SLOT}" {
        Padding 5 0 5 0
       }
      }
      ButtonWidgetClass "{GROUP_WITHDRAW_BTN}" : "{0114A06AD44D49BD}UI/layouts/WidgetLibrary/Buttons/DialogButtonCancel.layout" {
       Name "WithdrawButton"
       Slot LayoutSlot "{GROUP_WITHDRAW_SLOT}" {
        Padding 5 0 0 0
       }
      }
     }
    }
    VerticalLayoutWidgetClass "{GROUP_ACTIONS}" {
     Slot LayoutSlot "{GROUP_ACTIONS_SLOT}" {
      Padding 20 10 20 10
     }
     {
      ButtonWidgetClass "{GROUP_INVITE_BTN}" : "{51898FF369FE5EB8}UI/layouts/WidgetLibrary/Buttons/DialogButtonConfirm.layout" {
       Name "InviteButton"
       Slot LayoutSlot "{GROUP_INVITE_SLOT}" {
        Padding 0 5 0 5
       }
      }
      ButtonWidgetClass "{GROUP_KICK_BTN}" : "{0114A06AD44D49BD}UI/layouts/WidgetLibrary/Buttons/DialogButtonCancel.layout" {
       Name "KickButton"
       Slot LayoutSlot "{GROUP_KICK_SLOT}" {
        Padding 0 5 0 5
       }
      }
      ButtonWidgetClass "{GROUP_LEAVE_BTN}" : "{0114A06AD44D49BD}UI/layouts/WidgetLibrary/Buttons/DialogButtonCancel.layout" {
       Name "LeaveButton"
       Slot LayoutSlot "{GROUP_LEAVE_SLOT}" {
        Padding 0 5 0 5
       }
      }
      ButtonWidgetClass "{GROUP_DISBAND_BTN}" : "{0114A06AD44D49BD}UI/layouts/WidgetLibrary/Buttons/DialogButtonCancel.layout" {
       Name "DisbandButton"
       Slot LayoutSlot "{GROUP_DISBAND_SLOT}" {
        Padding 0 5 0 5
       }
      }
