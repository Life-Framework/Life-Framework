FrameWidgetClass : "{E6B607B27BCC1477}UI/layouts/Menus/Dialogs/ConfigurableDialog.layout" {
 {
  VerticalLayoutWidgetClass "{PROPERTY_ROOT_LAYOUT}" {
   {
    TextWidgetClass "{PROPERTY_TITLE}" {
     Text "#EL-Property_Manage"
     "Font Size" 24
     Slot LayoutSlot "{PROPERTY_TITLE_SLOT}" {
      HorizontalAlign 1
      Padding 0 20 0 10
     }
    }
    ButtonWidgetClass "{PROPERTY_LOCK_BTN}" : "{51898FF369FE5EB8}UI/layouts/WidgetLibrary/Buttons/DialogButtonConfirm.layout" {
     Name "LockButton"
     Slot LayoutSlot "{PROPERTY_LOCK_SLOT}" {
      Padding 20 10 20 10
     }
    }
    ScrollLayoutWidgetClass "{PROPERTY_SCROLL}" {
     Slot LayoutSlot "{PROPERTY_SCROLL_SLOT}" {
      SizeMode Fill
      FillWeight 1
      Padding 20 10 20 10
     }
     {
      VerticalLayoutWidgetClass "{PROPERTY_FURNITURE_LIST}" {
       Name "FurnitureList"
      }
     }
    }
    HorizontalLayoutWidgetClass "{PROPERTY_ADD_ROW}" {
     Slot LayoutSlot "{PROPERTY_ADD_SLOT}" {
      Padding 20 10 20 10
     }
     {
      EditBoxWidgetClass "{PROPERTY_FURNITURE_INPUT}" {
       Name "FurnitureInput"
       "Placeholder text" "Enter furniture name"
       Slot LayoutSlot "{PROPERTY_INPUT_SLOT}" {
        SizeMode Fill
        FillWeight 1
       }
      }
      ButtonWidgetClass "{PROPERTY_ADD_BTN}" : "{51898FF369FE5EB8}UI/layouts/WidgetLibrary/Buttons/DialogButtonConfirm.layout" {
       Name "AddFurnitureButton"
       Slot LayoutSlot "{PROPERTY_ADD_BTN_SLOT}" {
        Padding 10 0 0 0
       }
      }
     }
    }
    ButtonWidgetClass "{PROPERTY_CLOSE_BTN}" : "{0114A06AD44D49BD}UI/layouts/WidgetLibrary/Buttons/DialogButtonCancel.layout" {
     Name "CloseButton"
     Slot LayoutSlot "{PROPERTY_CLOSE_SLOT}" {
      Padding 20 20 20 20
     }
    }
   }
  }
 }
}