# Arma Reforger / Enfusion Engine
*.log
*.cache
*.tmp
*.bak
*.old

# Build artifacts
*.gproj.user
*.rdb
*.rdb.lock
addons/LifeFramework/log
addons/LF_Everon1989/log

# MCP server clones (managed via tools\cli.mjs - never commit)
tools/mcp/*/

# EnfusionMCP Workbench handler scripts (injected, never commit)
addons/LifeFramework/Scripts/WorkbenchGame/
addons/LF_Everon1989/Scripts/WorkbenchGame/

# Editor temporary files
*~
.DS_Store
Thumbs.db

# IDE specific files
.vscode/
.idea/
*.sublime-*

# Machine-local Cursor MCP config. agent-box/setup.ps1 rewrites this with
# absolute paths for the clone. Do not commit it.
.cursor/mcp.json

# Windows
desktop.ini
ehthumbs.db

# Backup files
*.backup
*_backup

# Temporary directories
temp/
tmp/
cache/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Node modules (if using any build tools)
node_modules/
package-lock.json
# ...except the website, which pins its dependencies (npm ci in CI).
!website/package-lock.json

# Python (if using any Python tools)
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/

# Play-mode visual report. `node agent-box/harness.mjs report roadmap` writes it.
agent-box/reports/

# Server runtime files
server/*.log
server/profile/
server/logs/
server/build/

# Don't ignore example configs
!server/configs/*.example.json
!server/scripts/*.example.bat
!server/scripts/*.example.sh


# Portable ffmpeg for the filming harness. `node tools/film/film.mjs fetch` writes it.
tools/film/.bin/
# Piper TTS and its voice for film-make voice-over (node tools/film/post.mjs --setup).
tools/film/.tts/

# Website build output and generated content (website/README.md)
website/dist/
website/src/generated/
website/.wrangler/

# Machine-local settings (tools/lib/local-config.mjs): install paths, test box host
lf.local.json

# Film post-production inputs: licensed music is fetched, never committed (docs/credits.md).
video/music/*.mp3

# Example server template runtime files
server/example/profile/
