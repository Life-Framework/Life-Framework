{
  "name": "life-framework-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "snapshot": "node scripts/build-content.mjs --update-snapshot",
    "dev": "npm run content && vite",
    "build": "npm run content && tsc -p tsconfig.app.json --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "npm run content && eslint .",
    "preview": "vite preview",
    "check-links": "node scripts/check-links.mjs",
    "check-routes": "node scripts/check-routes.mjs",
    "check": "node scripts/check-routes.mjs --dist && node scripts/check-links.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "github-slugger": "^2.0.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "qrcode-generator": "2.0.4",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "unified": "^11.0.5",
    "vite": "^5.4.19"
  },
  "engines": {
    "node": ">=20"
  }
}
