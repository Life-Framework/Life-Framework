{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Framework owner config",
  "description": "The owner's $profile:LifeFramework/config.json. Generated by tools/config/schema.mjs from the config classes' [Attribute] declarations; do not edit by hand.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 1,
      "description": "Owner file schema version. A file without it is version 1."
    },
    "shops": {
      "type": "object",
      "description": "Price table for the shop system.",
      "properties": {
        "defaultBuyPrice": {
          "type": "integer",
          "description": "Default buy price when no rule matches",
          "default": 50,
          "minimum": 0,
          "maximum": 1000000
        },
        "defaultSellPrice": {
          "type": "integer",
          "description": "Default sell price when no rule matches",
          "default": 25,
          "minimum": 0,
          "maximum": 1000000
        },
        "priceRules": {
          "type": "object",
          "description": "Ordered price rules; later matches override earlier ones. Records are an object keyed by a stable key. The rule's key is a prefab-path substring, or type:<flags>,mode:<mode> to match by arsenal type (mode defaults to 2, any). A key no shipped rule has adds a rule; an existing key changes only the fields given.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "prefab": {
                "type": "string",
                "default": ""
              },
              "buyPrice": {
                "type": "integer",
                "description": "Buy price: what the player pays",
                "default": 100,
                "minimum": 0,
                "maximum": 1000000
              },
              "sellPrice": {
                "type": "integer",
                "description": "Sell price: what the shop pays the player",
                "default": 50,
                "minimum": 0,
                "maximum": 1000000
              },
              "hidden": {
                "type": "boolean",
                "description": "Never offer this item in any shop",
                "default": false
              }
            },
            "additionalProperties": false
          }
        },
        "extraItemPrefabs": {
          "type": "array",
          "description": "Extra item prefabs priced outside the entity catalog",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "x-class": "LF_ShopPricesConfig"
    },
    "vehicles": {
      "type": "object",
      "description": "Vehicle prices.",
      "properties": {
        "buyPercent": {
          "type": "integer",
          "default": 100
        },
        "sellBackPercent": {
          "type": "integer",
          "default": 50
        },
        "chopPercent": {
          "type": "integer",
          "default": 30
        },
        "chopValueCap": {
          "type": "integer",
          "default": 3000
        },
        "impoundPercent": {
          "type": "integer",
          "default": 10
        },
        "garagePercent": {
          "type": "integer",
          "default": 0
        },
        "vehicles": {
          "type": "object",
          "description": "",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "prefab": {
                "type": "string",
                "default": ""
              },
              "spawnPrefab": {
                "type": "string",
                "default": ""
              },
              "basePrice": {
                "type": "integer",
                "default": 0
              },
              "buyOverride": {
                "type": "integer",
                "default": -1
              },
              "sellBackOverride": {
                "type": "integer",
                "default": -1
              },
              "chopOverride": {
                "type": "integer",
                "default": -1
              },
              "impoundOverride": {
                "type": "integer",
                "default": -1
              },
              "garageOverride": {
                "type": "integer",
                "default": -1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "x-class": "LF_VehiclePricesConfig"
    }
  },
  "additionalProperties": false
}
