# Merge drivers selected by .gitattributes.
# Register once per clone (the pre-commit hook does this):
#   git config --local --add include.path <repo>/tools/merge/drivers.gitconfig
# The driver commands run with the worktree as the current directory.

[merge "lf-string-table"]
	name = Union localization string ids
	driver = node tools/merge/union-string-table.mjs %O %A %B %P

[merge "lf-regen-localization"]
	name = Regenerate language confs
	driver = node tools/merge/regen-generated.mjs %O %A %B %P

[merge "lf-regen-tests"]
	name = Regenerate the test registry
	driver = node tools/merge/regen-generated.mjs %O %A %B %P

[merge "lf-markdown"]
	name = Line merge that keeps both sides appended rows
	driver = node tools/merge/merge-markdown.mjs %O %A %B %P

[merge "lf-lint-baseline"]
	name = Three-way multiset merge of the enforce-lint baseline
	driver = node tools/merge/union-lint-baseline.mjs %O %A %B %P
