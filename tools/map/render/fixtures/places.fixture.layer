// Fixture layer for tools/validation/map-places-selftest.mjs and `map render --world <this file>`. Not a real world:
// one place per rule the emulator's overlay reader must get right. Kinds are the neutral ones in LF_MapPois.conf
// (and the pack's Fence). All coordinates are made up.
GenericEntity Fix_Hospital {
 components {
  LF_PlaceComponent "{24218E86E931E2E7}" {
   m_sKind "HospitalSite"
  }
 }
 coords 100 0 100
}
