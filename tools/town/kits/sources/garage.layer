// Source of the `garage` kit (tools/town/kits/garage.json): the mechanic counter's till. `town fit` reads each component's GUID
// and the nested blocks (action contexts, additional actions) from here, matched on the row's prefab and name. It is the
// hardware store's till (tools/town/kits/sources/hardware.layer, #3220) pointed at the pack's `mechanic` stock (#3218).
GenericEntity Mechanic_Till : "{4E4E1620C6B02E1F}Prefabs/Props/Commercial/EL_FuelTill.et" {
 components {
  LF_ShopComponent "{9AA33D561FE4F951}" {
   m_sShopName "#LF-Shop_Name_Mechanic"
   m_sShopDescription "#LF-Shop_Desc_Mechanic"
   m_sStockId "mechanic"
  }
  ActionsManagerComponent "{5A4B0B84C86E4845}" {
   ActionContexts {
    UserActionContext "{4CA4725D850B4E7B}" {
     ContextName "default"
     Radius 1.6
     Position PointInfo "{1656ECB098CE371A}" {
      Offset 0 0.3 0.35
     }
    }
   }
   additionalActions {
    LF_ShopAction "{3595229CFA97493A}" {
     ParentContextList {
      "default"
     }
     UIInfo UIInfo "{77F6A5C7AF587609}" {
      Name "#LF-Shop_Open_Mechanic"
      Description "#LF-Shop_OpenDesc_Mechanic"
     }
    }
   }
  }
 }
 coords 0 0 0
}
