// Source of the `hardware` kit (tools/town/kits/hardware.json): the two counters' tills. `town fit` reads each component's GUID
// and the nested blocks (action contexts, additional actions) from here, matched on the row's prefab and name. They are the
// general store's tills (Place_saint-philippe_general-store.layer, #3085) pointed at the `hardware` stock and the
// `miners_supply` catalogue outlet. The shop counter's stock is the pack's `hardware` stock (#3218); the miner's supply
// counter sells the pickaxe behind the MINER job gate.
GenericEntity Hardware_Till : "{4E4E1620C6B02E1F}Prefabs/Props/Commercial/EL_FuelTill.et" {
 components {
  LF_ShopComponent "{7C21A0B5D93E4F10}" {
   m_sShopName "#LF-Shop_Name_Hardware"
   m_sShopDescription "#LF-Shop_Desc_Hardware"
   m_sStockId "hardware"
  }
  ActionsManagerComponent "{5A4B0B84C86E4845}" {
   ActionContexts {
    UserActionContext "{7C21A0B5D93E4F11}" {
     ContextName "default"
     Radius 1.6
     Position PointInfo "{7C21A0B5D93E4F12}" {
      Offset 0 0.3 0.35
     }
    }
   }
   additionalActions {
    LF_ShopAction "{7C21A0B5D93E4F13}" {
     ParentContextList {
      "default"
     }
     UIInfo UIInfo "{7C21A0B5D93E4F14}" {
      Name "#LF-Shop_Open_Hardware"
      Description "#LF-Shop_OpenDesc_Hardware"
     }
    }
   }
  }
 }
 coords 0 0 0
}
