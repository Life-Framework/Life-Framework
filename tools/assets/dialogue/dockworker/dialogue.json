  "lines": {
    "greet": {
      "text": "Mind your feet, the crane swings wide. You want something, or are you just watching us sweat?"
    },
    "about_cargo": {
      "text": "Flour, diesel, machine parts. What is in the other crates is the harbor master's business, and he does not share."
    },
    "about_work": {
      "text": "Ask the harbor master. He hires by the day when a boat comes in, and pays when the boat is empty."
    },
    "bye": {
      "text": "Off you go, then."
    }
  },
  "replies": {
    "cargo": "What came in on the boat?",
    "work": "Any work on the docks?",
    "bye": "I'll leave you to it."
  }
}
