      "voice_name": "Raspy - Convincing and Weary Narrator",
      "model": "eleven_multilingual_v2",
      "text": "Up by the hilltop mast somebody left a camp. Fresh boot prints, a cold fire. You can see the whole valley from there.",
      "chars": 117,
      "chars_total": 47,
      "request_id": "0hWXkRsaXAPFP5mCAYgO",
      "seconds": 8.7,
      "mouth": "593100998798339981336821388766863411134585358876126601459875411110122397568622199710039866434168203349996311288766654310099996468555599588228999764777766531277765666655432100"
    },
