  "lines": {
    "greet": {
      "text": "Fresh today. Have a look."
    },
    "what": {
      "text": "I buy and sell at the stall. Bring me what you grow or make and I will give you a fair price."
    },
    "where": {
      "text": "The farm is out past the greenhouse. For anything else, the {town} board on the square will tell you."
    },
    "rumour": {
      "text": "The price of apples went up this week. Somebody is hoarding them, I think."
    },
    "bye": {
      "text": "Come back when you have more."
    }
  },
  "replies": {
    "what": "What do you do here?",
    "where": "Can you point me somewhere?",
    "rumour": "Heard anything lately?",
    "more": "One more thing.",
    "bye": "Goodbye.",
    "browse": "Show me what you've got."
