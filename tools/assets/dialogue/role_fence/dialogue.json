  "lines": {
    "greet": {
      "text": "You did not see me. Now, what are you after?"
    },
    "what": {
      "text": "I sell tools to people who do not ask what they are for. Locks are hard and the {police} are harder. Choose the right tool."
    },
    "where": {
      "text": "Ask nobody about me. Keep to the back streets."
    },
    "rumour": {
      "text": "Somebody sold a drill and a charge to the wrong customer. The wrong customer was the {police}."
    },
    "bye": {
      "text": "We never spoke."
    }
  },
