  "lines": {
    "greet": {
      "text": "Mind the oil. What is wrong with it?"
    },
    "what": {
      "text": "I fix cars. A new battery, a repair kit, the right fuel, and it runs. Most breakdowns are a flat battery."
    },
    "where": {
      "text": "The car lot is on the east side, and the fuel station is down the road. Fill up before you go far."
    },
    "rumour": {
      "text": "Somebody keeps asking me how to start a car without the key. I tell them to buy the key."
    },
    "bye": {
      "text": "Drive safe."
    }
  },
  "replies": {
    "what": "What do you do here?",
    "where": "Can you point me somewhere?",
    "rumour": "Heard anything lately?",
