  "lines": {
    "ticket": {
      "text": "Paying a ticket? Put it on the counter and I'll stamp it."
    },
    "booking": {
      "text": "Booking? Sign the sheet where it's marked. Name, charge, time. Then the stamp, and it's official."
    },
    "pay_now": {
      "text": "You can pay the fine now and walk out, or serve the time. Cash only. No checks."
    },
    "cell": {
      "text": "The cell is down the hall, second door. Mind the step. Someone will let you out when your time is up."
    },
    "bye": {
      "text": "Good day. Keep your paperwork."
    }
  },
  "replies": {
    "book": "I'm here to be booked.",
    "pay": "Can I pay it now?",
    "cell": "Where do I serve it?",
    "bye": "That's all. Goodbye."
