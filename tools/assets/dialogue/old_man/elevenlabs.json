{
  "id": "old_man",
  "service": "ElevenLabs text-to-speech",
  "lines": {
    "greet": {
      "hash": "28310f1f9f9faab1",
      "date": "2026-11-16",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "Sit down a minute. Everyone is in a hurry these days. I only watch the square.",
      "chars": 78,
      "chars_total": 31,
      "request_id": "LQlRGi1FblTq0p8PsLDK",
      "seconds": 6.44,
      "mouth": "599982177788775655544531000000000000098967985967888768744799987635546514655443576410000000009655786689746972475468973357889852100"
    },
    "zone": {
      "hash": "57a649242c1bd7cf",
      "date": "2026-11-16",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "I lived near the zone. We were given one morning to pack. One suitcase each. I took my wife's coat and a jar of her cherry jam. The jam is gone. The coat I keep.",
      "chars": 161,
      "chars_total": 64,
      "request_id": "HlKCJsYkPfsupYntvjUW",
      "seconds": 14.9,
      "mouth": "67989999958888866699955444443211111111111111899999499579666798888666666556531446765211521110111001111368777999784144675999444214765311001010011010002563997314565467755991446762101100100125568528689998546416656655435654443211111100011101148458666555981634443221111100100111137254467667632446552111000"
    },
    "move": {
      "hash": "65d8bbbbea4ab7f6",
      "date": "2026-11-16",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "The first winter was hard. But the island people brought us wood and soup, and nobody asked what we had left behind. That is how you start again.",
      "chars": 145,
      "chars_total": 58,
      "request_id": "SVHnCeiJBevhcNH7IlfC",
      "seconds": 12.08,
      "mouth": "96569979234665865457944898876424210000000000047315789998675524796148863100000003699997789436895667799544420111000000000865657993767877999771224632575645574510384366666666343100000000000000379998314641000001565734556676954455145355555532321100"
    },
    "start": {
      "hash": "c97df64a74276929",
      "date": "2026-11-16",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "Read the town board on the square. It shows where everything is. Then see the clerk, right beside it. He was kind to us, and he will be kind to you.",
      "chars": 148,
      "chars_total": 59,
      "request_id": "Vj0ro8ZIorXkM9U0IjyS",
      "seconds": 12.7,
      "mouth": "589974852965555565456663445459962345554321000000000000653489689998999110000036777646443465554322699962000000000000167769998684732335653133100000002355521349975433232124321000000000014889998554797658866643499984100000035435669996583444556564745433333321000"
    },
    "bye": {
      "hash": "9b21a2e494d31e7c",
      "date": "2026-11-16",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "Go well. Come and sit with me again some time.",
      "chars": 46,
      "chars_total": 18,
      "request_id": "z9UkuyUiQiIVoVEFDwiu",
      "seconds": 2.85,
      "mouth": "699679997531000000249575699825413689268656754425467542100"
    },
    "greet_refuses": {
      "hash": "762f65517cea9c84",
      "date": "2026-11-18",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "I saw what you did. Keep walking.",
      "chars": 33,
      "chars_total": 13,
      "request_id": "kZNxA3DAlUww42sP5HNV",
      "seconds": 2.36,
      "mouth": "797999798696246474575321110124675236773357542000"
    },
    "greet_wary": {
      "hash": "f648b60a7e5a9238",
      "date": "2026-11-18",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "Hm. You again. Say what you want, and be quick.",
      "chars": 47,
      "chars_total": 19,
      "request_id": "t1wq739Gfdew4R4qFSuE",
      "seconds": 3.56,
      "mouth": "688876310000000002445453667886642100007999999789779974645654235531531000"
    },
    "greet_friendly": {
      "hash": "cd7db08b84743d40",
      "date": "2026-11-18",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "Ah, there you are. A friendly face is good to see. Sit a moment.",
      "chars": 64,
      "chars_total": 26,
      "request_id": "yfcwJLHAMMUSLR1WTUAi",
      "seconds": 6.3,
      "mouth": "579933799986565457676577631110000000048543358744456433468867955641455215349994333332110110111010111699979659333543333321133100"
    },
    "greet_regular": {
      "hash": "79975292aea10752",
      "date": "2026-11-22",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "My friend! The harbor is better for having you in it. What can an old fisherman do for you?",
      "chars": 91,
      "chars_total": 73,
      "request_id": "O2NK9eGSVW56W2l4cUjv",
      "seconds": 6.94,
      "mouth": "5686776999876482100000000000048669999758997951689675656558844556654565651751000000000000002672188888888997567699876656587556764555655553100"
    },
    "cove": {
      "hash": "1bd6f7b4d8848071",
      "date": "2026-11-19",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "You have the hands for it now. There is a cove below the lighthouse, Fisherman Bay. Go at dusk, when the bass come in close. I have marked it on your map.",
      "chars": 154,
      "chars_total": 62,
      "request_id": "SetUdYe5Ilkugk7r3Icl",
      "seconds": 12.2,
      "mouth": "46547995477457976799347875234555433210000000000000016788779623379997512977998484566523476448985100000012658856566764445666421000000000000005779962179849991210000002787763599949914455553224654379986100000000005678654559971176566555433455431111000"
    },
    "anniversary_letter_thanks": {
      "hash": "935a1913bf7b87c6",
      "date": "2026-11-19",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "Dominique. Three years, and it comes to me out of a heap of flowers. Thank you for carrying it.",
      "chars": 95,
      "chars_total": 38,
      "request_id": "1yVw27RBMzUWPmqs0BpC",
      "seconds": 9.15,
      "mouth": "989889878884144111001010011567999878777655999411111177879627666779999676666411111011119999997686445677216767532477898886459984100000011001011011478546777863124531877998878867751154100"
    },
    "anniversary_letter_secret": {
      "hash": "044fa0dd4d20b302",
      "date": "2026-11-19",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "Dominique counted the drums before they emptied the Zone. He wrote the markings down for the mayor. I saw the same marks on the night boats, and I said nothing. Keep this to yourself until you know who is listening.",
      "chars": 215,
      "chars_total": 86,
      "request_id": "YoW6NzQENNBdnwWNKqQo",
      "seconds": 18.57,
      "mouth": ""
    },
    "letter_desc": {
      "hash": "4dfe7b112f260c56",
      "date": "2026-11-26",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "The letter in the memorial's flowers is addressed to me. Bring it here, if you would.",
      "chars": 85,
      "chars_total": 34,
      "request_id": "wzRFuIQkYQrg64H6Zisc",
      "seconds": 5.7,
      "mouth": "9986887467755755765456667769832478877668858974256978959544445543210000000000000003899799569999994436655456642421000"
    },
    "letter_turn_in": {
      "hash": "2697de0d8a415898",
      "date": "2026-11-26",
      "voice_id": "nTMUXLFSfbWmdKKy7nDC",
      "voice_name": "Alder - Warm, Raspy and Comforting",
      "model": "eleven_multilingual_v2",
      "text": "Let me read it twice. Then sit with me a while.",
      "chars": 47,
      "chars_total": 19,
      "request_id": "XjQe0dZfog0hMXDmc72g",
      "seconds": 3.27,
      "mouth": "268758985779684195478759997246843665999933542267653478886321001000"
    }
  },
