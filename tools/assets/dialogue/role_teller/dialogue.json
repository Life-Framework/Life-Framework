  "lines": {
    "greet": {
      "text": "Good day. Welcome to the bank. How can I help?"
    },
    "what": {
      "text": "I keep the counter and the accounts. Cash in your pocket is gone when you die. Money in the bank is not. The cash machine on the wall does deposits and withdrawals."
    },
    "where": {
      "text": "The post office is right beside us. The {town} board on the square lists the rest, and the {police} station is a short walk up the street."
    },
    "rumour": {
      "text": "A man with no work and a drill in his bag asked me about the vault. I told him the vault is none of my business."
    },
    "bye": {
      "text": "Good day. Mind your money."
    }
  },
  "replies": {
    "what": "What do you do here?",
    "where": "Can you point me somewhere?",
    "rumour": "Heard anything lately?",
    "more": "One more thing.",
    "bye": "Goodbye.",
    "browse": "Show me what you've got."
  }
