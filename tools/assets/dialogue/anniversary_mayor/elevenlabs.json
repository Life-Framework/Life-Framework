      "date": "2026-11-26",
      "voice_id": "CKPSX8kOS9MJCGVaFNok",
      "voice_name": "Henri - French-American Narrator",
      "model": "eleven_multilingual_v2",
      "text": "The anniversary is tomorrow and the square is short of seats. Bring four chairs for the trestles.",
      "chars": 97,
      "chars_total": 39,
      "request_id": "rCySerXNhDy1z7B5bmjD",
