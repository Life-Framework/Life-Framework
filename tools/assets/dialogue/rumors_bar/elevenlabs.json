      "date": "2026-11-23",
      "voice_id": "KvaCHcJoMXfOzwtsULOZ",
      "voice_name": "Hank Harvey - Gruff, Rugged and Wise",
      "model": "eleven_multilingual_v2",
      "text": "The old barn off the road is not empty at night. Lights, a truck with no plates, a smell like sour mash. I pour what I pour and keep quiet.",
