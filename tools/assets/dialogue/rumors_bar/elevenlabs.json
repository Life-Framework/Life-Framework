      "voice_name": "Hank Harvey - Gruff, Rugged and Wise",
      "model": "eleven_multilingual_v2",
      "text": "The hardware store has tools. A man with a pick works faster than a man without one.",
      "chars": 84,
      "chars_total": 34,
