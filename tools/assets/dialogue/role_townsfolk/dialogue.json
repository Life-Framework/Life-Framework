  "lines": {
    "greet": {
      "text": "Hello. New in {town}?"
    },
    "what": {
      "text": "I live here. I get by, as everyone does. The work is simple and the people are decent."
    },
    "where": {
      "text": "The {town} board on the square shows everything. The post office hires couriers, and the bank is beside it."
    },
    "rumour": {
      "text": "People say the {police} are watching the main street. Burglars are about. Keep your doors locked."
    },
    "bye": {
      "text": "Take care."
    }
  },
  "replies": {
    "what": "What do you do here?",
    "where": "Can you point me somewhere?",
    "rumour": "Heard anything lately?",
    "more": "One more thing.",
    "bye": "Goodbye.",
    "browse": "Show me what you've got."
  }
