      "voice_id": "en_US-ljspeech-high",
      "voice_name": "LJ Speech (Piper)",
      "model": "piper",
      "engine": "piper",
      "text": "I worked near the Zone before they moved us. Twelve kilometres from the reactor. They told us three days. That was three years ago. I still keep my house key.",
