      "voice_id": "HL6h30e2Rd3SQjMZu1Wz",
      "voice_name": "Raspy - Convincing and Weary Narrator",
      "model": "eleven_multilingual_v2",
      "text": "I know your face from the night. Do not speak to me.",
      "chars": 52,
      "chars_total": 21,
      "request_id": "gdysZuUXaEgJPIMrK2LL",
      "seconds": 3.3,
      "mouth": "389998979422227863553257655556431021003988973640792035776543119500"
