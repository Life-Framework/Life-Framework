      "voice_id": "HL6h30e2Rd3SQjMZu1Wz",
      "voice_name": "Raspy - Convincing and Weary Narrator",
      "model": "eleven_multilingual_v2",
      "text": "My friend! The night is long and your company shortens it. What do you want to know?",
      "chars": 84,
      "chars_total": 34,
      "request_id": "a1xd94PpMLKnrFUGq55a",
      "seconds": 5.04,
      "mouth": "99994118987554379999789876777999642688755658716485168554387267864431256882278998799713478777766543100"
