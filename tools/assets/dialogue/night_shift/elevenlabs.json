      "date": "2026-11-18",
      "voice_id": "HL6h30e2Rd3SQjMZu1Wz",
      "voice_name": "Raspy - Convincing and Weary Narrator",
      "model": "eleven_multilingual_v2",
      "text": "You again. Make it short, I have work.",
      "chars": 38,
      "chars_total": 15,
      "request_id": "u1HYOk96gV4fb6M97hn1",
      "seconds": 2.24,
