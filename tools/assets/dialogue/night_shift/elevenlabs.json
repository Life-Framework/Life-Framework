      "date": "2026-11-16",
      "voice_id": "HL6h30e2Rd3SQjMZu1Wz",
      "voice_name": "Raspy - Convincing and Weary Narrator",
      "model": "eleven_multilingual_v2",
      "text": "Good night. Walk safe.",
      "chars": 22,
      "chars_total": 9,
      "request_id": "3dG1QfrHLHf6pmGlic0E",
      "seconds": 1.3,
      "mouth": "499965324688235556421111000"
    },
