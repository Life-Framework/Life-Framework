  "lines": {
    "greet": {
      "hash": "4fd8b135fa6e2b61",
      "date": "2026-11-16",
      "voice_id": "en_US-ljspeech-high",
      "voice_name": "Piper en_US-ljspeech-high",
      "model": "piper",
      "engine": "piper",
      "text": "Come in, come in. The coffee is hot. You are new here, I can tell. Nobody walks that slowly who has lived here long.",
      "chars": 116,
      "chars_total": 0,
      "request_id": "",
      "seconds": 7.42,
      "mouth": "29967955134976653200000061389942677652597211220000007999867874226786699247533897721000003999499775278951354717738963631362386647741331576446676321000"
    },
    "zone": {
      "hash": "3e4f08426d36c82a",
      "date": "2026-11-16",
      "voice_id": "en_US-ljspeech-high",
      "voice_name": "Piper en_US-ljspeech-high",
      "model": "piper",
      "engine": "piper",
      "text": "I came out of the zone. They told us three days. Pack what you can carry, they said, and you will be back by Friday. I took the kettle and my mother's cups. That was three years ago.",
      "chars": 182,
      "chars_total": 0,
      "request_id": "",
      "seconds": 11.77,
      "mouth": "39623875289744255699986221100001998249985993572148762697542124310000025985124511411443114865443100000974664655310003545656535218977411376211599847521000003994472151299984454578549956545126831156410000069962154421114664358664342676632000"
    },
    "move": {
      "hash": "5adae939e191bd30",
      "date": "2026-11-16",
      "voice_id": "en_US-ljspeech-high",
      "voice_name": "Piper en_US-ljspeech-high",
      "model": "piper",
      "engine": "piper",
      "text": "When they brought us here, the town did not know what to say. So a neighbour brought bread, and nobody asked a single question. I still use the cups. Every day. Someone has to.",
      "chars": 176,
      "chars_total": 0,
      "request_id": "",
      "seconds": 11.65,
      "mouth": "77995279957686216798641000074368855426369843998499314378798632000001698998977865564100079951148873110000069877985796633544451346987648511199462432000000699567928984357643315138961157641000005943652178862100000059997697434765676542100"
    },
    "work": {
      "hash": "f0c4336cfd253795",
      "date": "2026-11-16",
      "voice_id": "en_US-ljspeech-high",
      "voice_name": "Piper en_US-ljspeech-high",
      "model": "piper",
      "engine": "piper",
      "text": "If you need work, ask at the post office. They always need couriers. Walk fast, keep the parcels dry, and you will be paid by the end of the day.",
      "chars": 145,
      "chars_total": 0,
      "request_id": "",
      "seconds": 10.51,
      "mouth": "9633698668762389972111000000007975752713114764739873143254410000099599988995545875320126997555432556210000199942221999653255120000001821461189945665522599897652000036446878725411688841996551265435214139998421000"
    },
    "clerk": {
      "hash": "681941a13d678554",
      "date": "2026-11-16",
      "voice_id": "en_US-ljspeech-high",
      "voice_name": "Piper en_US-ljspeech-high",
      "model": "piper",
      "engine": "piper",
      "text": "Before anything else, see the town clerk at the desk on the square. He keeps the register. A person who is not in it is no one at all, here.",
      "chars": 140,
      "chars_total": 0,
      "request_id": "",
      "seconds": 8.45,
      "mouth": "42269998652464676543553100000039775633487641218984351521696981564437621798864100000096339728537799344793453100000631299775535798779895254868555996554666887410016788410000"
    },
    "handbook": {
      "hash": "e4065a9e9f3f0b53",
      "date": "2026-11-16",
      "voice_id": "en_US-ljspeech-high",
      "voice_name": "Piper en_US-ljspeech-high",
      "model": "piper",
      "engine": "piper",
      "text": "And read the handbook. It is short. It tells you what the town expects of you, and what the police will not forgive.",
      "chars": 116,
      "chars_total": 0,
      "request_id": "",
      "seconds": 6.69,
      "mouth": "99869983594699875885111000002998967555899621220000006213988553456131388754275284126523678841000199638933511677572654577512352365421000"
    },
    "bye": {
      "hash": "252a3cf4851a300b",
      "date": "2026-11-16",
      "voice_id": "en_US-ljspeech-high",
      "voice_name": "Piper en_US-ljspeech-high",
      "model": "piper",
      "engine": "piper",
      "text": "Come back when you are hungry. Or lonely. It is the same to me.",
      "chars": 63,
      "chars_total": 0,
      "request_id": "",
      "seconds": 4.16,
      "mouth": "288543599862117645679973257335542100000699976997544310000009998624877765353646431000"
    }
  },
