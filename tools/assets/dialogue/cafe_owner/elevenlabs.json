{
  "id": "cafe_owner",
  "service": "Piper text-to-speech (en_US-ljspeech-high, LJ Speech, public domain); free, offline, no characters billed",
  "lines": {
    "greet": {
      "hash": "cab82fa5fa1835f2",
      "date": "2026-11-19",
      "voice_id": "I1T6PEfqPxl45yKRN4aS",
      "voice_name": "Marcel - Charming Native Accent",
      "model": "eleven_multilingual_v2",
      "text": "Come in, come in. The coffee is hot. You are new here, I can tell. Nobody walks that slowly who has lived here long.",
      "chars": 116,
      "chars_total": 92,
      "request_id": "WxNK4dB6e3h8YZF8Kdoy",
      "seconds": 7.63,
      "mouth": "699999999727988888875100000137659932776468775111100000000000057978999899987743763477655300000016783883566898431672325885665555577764357634776667665343100"
    },
    "zone": {
      "hash": "304ff63b6f08b72a",
      "date": "2026-11-19",
      "voice_id": "I1T6PEfqPxl45yKRN4aS",
      "voice_name": "Marcel - Charming Native Accent",
      "model": "eleven_multilingual_v2",
      "text": "I came out of the zone. They told us three days. Pack what you can carry, they said, and you will be back by Friday. I took the kettle and my mother's cups. That was three years ago.",
      "chars": 182,
      "chars_total": 146,
      "request_id": "lejxRJ952ZhJ9po5DKY9",
      "seconds": 12.09,
      "mouth": "68614998898187567647988762000000000004992399789644226864998643210000000002998613798128389944998988738633788445000000688878879746846988344886247884874100000001686149445835963998878899999778743279513321000000000000005962698433597689864855986100"
    },
    "move": {
      "hash": "7f3019f0b8ccce92",
      "date": "2026-11-19",
      "voice_id": "I1T6PEfqPxl45yKRN4aS",
      "voice_name": "Marcel - Charming Native Accent",
      "model": "eleven_multilingual_v2",
      "text": "When they brought us here, the town did not know what to say. So a neighbour brought bread, and nobody asked a single question. I still use the cups. Every day. Someone has to.",
      "chars": 176,
      "chars_total": 140,
      "request_id": "ckT7WpBBHAxWjAmKNhdA",
      "seconds": 11.47,
      "mouth": "49996994899728843278996476169886675995179998971253327764300000000000000113399988998399964697367988465100000006889859656888440264334759933884136641000000006844128778997459239961331000000687688589875410000000000133789888885412652000"
    },
    "work": {
      "hash": "6a5ad5160af05198",
      "date": "2026-11-19",
      "voice_id": "I1T6PEfqPxl45yKRN4aS",
      "voice_name": "Marcel - Charming Native Accent",
      "model": "eleven_multilingual_v2",
      "text": "If you need work, ask at the post office. They always need couriers. Walk fast, keep the parcels dry, and you will be paid by the end of the day.",
      "chars": 145,
      "chars_total": 116,
      "request_id": "Hv3Zqz9g19kYoNKP9gGh",
      "seconds": 9.32,
      "mouth": "7339999689999414100038844485476199426723633210000000000000059999999943783038876676432100000002589913289886341100002684348458853674356888874100000000378887974761798636874468787744745642000"
    },
    "clerk": {
      "hash": "fabd19129bc7d82d",
      "date": "2026-11-19",
      "voice_id": "I1T6PEfqPxl45yKRN4aS",
      "voice_name": "Marcel - Charming Native Accent",
      "model": "eleven_multilingual_v2",
      "text": "Before anything else, see the town clerk at the desk on the square. He keeps the register. A person who is not in it is no one at all, here.",
      "chars": 140,
      "chars_total": 112,
      "request_id": "fSW4GHdNrC0zX8NrGw2O",
      "seconds": 9.21,
      "mouth": "47628999884278699744310000001333754750688843788427636845974248847542288753100000000000175298446989945542776310000000000047249944888999986489981788994122100156548998988953798855686541000"
    },
    "handbook": {
      "hash": "f0a897aa6b98986b",
      "date": "2026-11-19",
      "voice_id": "I1T6PEfqPxl45yKRN4aS",
      "voice_name": "Marcel - Charming Native Accent",
      "model": "eleven_multilingual_v2",
      "text": "And read the handbook. It is short. It tells you what the town expects of you, and what the police will not forgive.",
      "chars": 116,
      "chars_total": 92,
      "request_id": "P1V7ZJhHt0EvkIeD1yVY",
      "seconds": 7.14,
      "mouth": "58899995599999599813211000000000027256455898531110000000026229954478799336616976753328623674579951000002676896348328776324977887215736752122100"
    },
    "bye": {
      "hash": "c6b2aaec1ec717b2",
      "date": "2026-11-19",
      "voice_id": "I1T6PEfqPxl45yKRN4aS",
      "voice_name": "Marcel - Charming Native Accent",
      "model": "eleven_multilingual_v2",
      "text": "Come back when you are hungry. Or lonely. It is the same to me.",
      "chars": 63,
      "chars_total": 50,
      "request_id": "sEI3udjNr2HFDfR0u8H5",
      "seconds": 4.15,
      "mouth": "89969972698788998898599987410000000789899999888510000000000025255466438774277896300"
    },
    "greet_refuses": {
      "hash": "6d76e47c7a79d1c0",
      "date": "2026-11-19",
      "voice_id": "I1T6PEfqPxl45yKRN4aS",
      "voice_name": "Marcel - Charming Native Accent",
      "model": "eleven_multilingual_v2",
      "text": "I have nothing to say to you. Please leave my cafe.",
      "chars": 51,
      "chars_total": 40,
      "request_id": "EmKtowiLQJ0xUNMnrqDJ",
      "seconds": 2.98,
      "mouth": "388989999926972554386248779741000000448853587498628725641000"
    },
    "greet_wary": {
      "hash": "7a53ac76d963c30c",
      "date": "2026-11-19",
      "voice_id": "I1T6PEfqPxl45yKRN4aS",
      "voice_name": "Marcel - Charming Native Accent",
      "model": "eleven_multilingual_v2",
      "text": "Oh. It is you. What do you need?",
      "chars": 32,
      "chars_total": 26,
      "request_id": "k9Pyqxxip1Mb1t4RvE2y",
      "seconds": 2.42,
      "mouth": "5999887520035415644589988510000059828899778454000"
    },
    "greet_friendly": {
      "hash": "316bd1b15caf72db",
      "date": "2026-11-19",
      "voice_id": "I1T6PEfqPxl45yKRN4aS",
      "voice_name": "Marcel - Charming Native Accent",
      "model": "eleven_multilingual_v2",
      "text": "Welcome back! You always bring a smile in with you. What can I do for you?",
      "chars": 74,
      "chars_total": 60,
      "request_id": "nE65nV22Tec3FQ4svimq",
      "seconds": 5.31,
      "mouth": "59982399949987620211000000000157899999999742698778432677767776863577741000000000489712376776585257778752000"
    },
    "greet_regular": {
      "hash": "3b4985551fb18e12",
      "date": "2026-11-19",
      "voice_id": "I1T6PEfqPxl45yKRN4aS",
      "voice_name": "Marcel - Charming Native Accent",
      "model": "eleven_multilingual_v2",
      "text": "There is my favourite customer! Sit, sit. Ask me anything.",
      "chars": 58,
      "chars_total": 46,
      "request_id": "WCEiFkc9hdlAFysLvUsn",
      "seconds": 3.7,
      "mouth": "58895699729969996149426889741000000123683243761110000037843167878625765200"
    }
