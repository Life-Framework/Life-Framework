  "lines": {
    "greet": {
      "text": "Morning. Looking for something in particular?"
    },
    "what": {
      "text": "I run the till and keep the shelves full. Bread, water, apples, dressings. If we do not have it, nobody in {town} does."
    },
    "where": {
      "text": "The market square is south of the main street if you want fruit and vegetables. Cars are sold at the lot on the east side."
    },
    "rumour": {
      "text": "Somebody has been asking whether I keep a safe under the counter. I do not, and I do not keep much cash either."
    },
    "bye": {
      "text": "Take care out there."
    }
  },
  "replies": {
    "what": "What do you do here?",
    "where": "Can you point me somewhere?",
    "rumour": "Heard anything lately?",
    "more": "One more thing.",
    "bye": "Goodbye.",
    "browse": "Show me what you've got."
  }
