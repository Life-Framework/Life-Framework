      "voice_name": "Nicolas - French accent & cozy whisper",
      "model": "eleven_multilingual_v2",
      "text": "Oh, I have plenty. Choose one, and I will whisper it.",
      "chars": 53,
      "chars_total": 21,
      "request_id": "a3m9LNE49Tt8kdioejuy",
      "seconds": 4.31,
