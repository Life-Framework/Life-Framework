      "voice_id": "mN8UWPJNnmcExNpfrkd2",
      "voice_name": "Nicolas - French accent & cozy whisper",
      "model": "eleven_multilingual_v2",
      "text": "The bell is two minutes slow, and has been since spring. I would fix it, but then what would I complain about?",
