      "voice_name": "Nicolas - French accent & cozy whisper",
      "model": "eleven_multilingual_v2",
      "text": "At the market, the woman with the plums waters down her cider. Buy the apples. Trust the apples.",
      "chars": 96,
      "chars_total": 38,
      "request_id": "PrMH5O0JPMgA0AczeebE",
