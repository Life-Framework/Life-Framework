{
  "id": "clerk_everon",
  "service": "ElevenLabs text-to-speech",
  "lines": {
    "greet": {
      "hash": "8bf90a24f204c220",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Good day. This is the town clerk's desk. What can I do for you?",
      "chars": 63,
      "chars_total": 50,
      "request_id": "ZpeoyyZoDHuQ9321jPzA",
      "seconds": 4.12,
      "mouth": "79599897311110000000049658859625999834697241543423211000000000096378765743353433000"
    },
    "register": {
      "hash": "1c612b23e1d29246",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "There. Your name is in the register, and this is your identity card. Keep it on you. The police may ask to see it.",
      "chars": 114,
      "chars_total": 92,
      "request_id": "2L67zrEjzajiuANVjGyE",
      "seconds": 8.28,
      "mouth": "4999942211000000000000000038999999997699987797444234321000000267664364477664477334523254444210000000000000429229576665341100000000002651597996344587776753144544554100"
    },
    "board": {
      "hash": "a0e730e38460cc5a",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Now read the town board on the square, right beside me. It shows where everything in town is.",
      "chars": 93,
      "chars_total": 74,
      "request_id": "YDIWO0091i4k2CijXupA",
      "seconds": 9.09,
      "mouth": "79999887511000000100137999954591994899986576644521102997686742586542111000000000157999227744687756644311000000000000000000298367659997445431110058631138968871177666745446676654432100"
    },
    "work_errand": {
      "hash": "540c8d4f54202eb4",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Time to earn your first wages. The post office is down the street. Take courier work at the counter, pick up a parcel, carry it to the drop at the east end of the street, and complete the run.",
      "chars": 192,
      "chars_total": 154,
      "request_id": "fskdUsw08G8cvPKoHEi0",
      "seconds": 13.55,
      "mouth": "44999998437952799997753279652586333433321000000000000351999986387325345523977655512752121100000000000000000389733369988877761362343265423321000000000009923825619689844644511000000000359999997147658329866312136164214896435987645565249732110000000014871397157741583676342000"
    },
    "bank": {
      "hash": "49bc12c0b617dcdc",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "You were paid in cash. Cash in a pocket is lost if you die. Money in the bank is not. Deposit some at the cash machine on the bank wall, next to the post office.",
      "chars": 161,
      "chars_total": 128,
      "request_id": "qzDMfGhXnkaNAeGcpUey",
      "seconds": 14.48,
      "mouth": "56999972799875664347525455641000000000000000000339999664136662199722742114533699985511026432636765434311000000000000000000599999996211357663777624547665222110000000000000000000268119999885244788751112995471378765286454788611139998847776114665552110000000046999823432686729954536442133332100"
    },
    "done": {
      "hash": "be8fea6f4883904c",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Welcome to Everon. Here is something to start you off. The town is yours now. The shops, the car lot, the police station and the organization office are all on the town board.",
      "chars": 175,
      "chars_total": 140,
      "request_id": "cVGlGD2h7JmPPohxy5XC",
      "seconds": 14.45,
      "mouth": "79993378741569996877554421100000000000100001799865499726776412345178644676563332100000000000037145599988622267558988746755541000000001100017787999525654310000000042143999898751311000000000008119879745359755476531366641109999899853865446567324434311111023675999998742113988715388774655533000"
    },
    "idle": {
      "hash": "8fbd0dff9990d788",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "You are settled in. The town board on the square shows the rest: the shops, the car lot, the police station and the organization office.",
      "chars": 136,
      "chars_total": 108,
      "request_id": "yHSFljzvlXhg8ZqzO0Rm",
      "seconds": 11.27,
      "mouth": "3899885549877899997411100000000000000000000000014961998999767649999557765551399984555875356553543212100000000000566759983166442100000002513449999985222100000000056199777352587556751110000001576651119995898657654364442323333000"
    },
    "about_work": {
      "hash": "11fe9c59c0aa6c6c",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "The post office always needs couriers. For anything else, read the town board. It lists who is hiring.",
      "chars": 102,
      "chars_total": 82,
      "request_id": "kRP9bARKr1wXgceDEsmC",
      "seconds": 8.76,
      "mouth": "39149987727953564441100000006999896478755327966544442100000000000000122771118999625764898655431100000158993953479996776442110000000000003863799564376422111001699653399875543000"
    },
    "about_town": {
      "hash": "20a8c59e117188eb",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Everon is a small island. People here know each other, and they remember faces. Stay honest and you will do well.",
      "chars": 113,
      "chars_total": 90,
      "request_id": "iP95LsJi85Qq9ihgm4ll",
      "seconds": 8.58,
      "mouth": "9979999878872111047554664999952676555443111000000000001005982896328888998734453652110047788577887746232865335243211101000000000013440599999766341210002675686787599796545200"
    },
    "bye": {
      "hash": "863a5bab0598b4ed",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Good day to you.",
      "chars": 16,
      "chars_total": 12,
      "request_id": "2vsbUDmnXAOQdftEoGPM",
      "seconds": 0.87,
      "mouth": "894497422545543000"
    },
    "welcome_papers": {
      "hash": "0d13a5152e4fc0be",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Welcome to Everon. First, your papers. Form R-89 is the relocation form, and I will file it under your name. Your identity card comes with it.",
      "chars": 142,
      "chars_total": 57,
      "request_id": "2WJh7RRG1JlHV5mDEEQY",
      "seconds": 11.66,
      "mouth": "999339975887845654531110000000000146999742211596269732654343110000000000013499997212999727958788887664121634767999963376446633465543100000000277897644549999876221279877777776541110000000000000006866439982646136997754132786537735312000"
    },
    "welcome_room": {
      "hash": "c9f193b94b792e7f",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "You sleep at the hostel tonight. The dormitory is upstairs, and any free bunk is yours. It is plain, but it is warm.",
      "chars": 116,
      "chars_total": 46,
      "request_id": "xXFCcOe7uYfl8E9JYyrH",
      "seconds": 9.8,
      "mouth": "7767559953922964985336334554411110000000000025736999973367664211555633522765443211000000000026531199998634487339974211488646987665331100000000000295743119369997655411100000007775774267999865554200"
    },
    "welcome_town": {
      "hash": "4998926c939ad54e",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "The town expects honest work and quiet nights. Greet your neighbours, pay what you owe, and ask the police if you are ever lost.",
      "chars": 128,
      "chars_total": 51,
      "request_id": "vfDh6BCqBhMQVBy8G1bo",
      "seconds": 10.23,
      "mouth": "5817938999877411016135319823331029999743577631211001373338998835643313332100000000000000002998259988773776333310000010008999989343858787641100000000015741129884329259756533331153228741129858765534343211100"
    }
  },
