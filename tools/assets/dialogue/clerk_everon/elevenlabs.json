{
  "id": "clerk_everon",
  "service": "ElevenLabs text-to-speech",
  "lines": {
    "greet": {
      "hash": "8bf90a24f204c220",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Good day. This is the town clerk's desk. What can I do for you?",
      "chars": 63,
      "chars_total": 50,
      "request_id": "ZpeoyyZoDHuQ9321jPzA",
      "seconds": 4.12,
      "mouth": "79599897311110000000049658859625999834697241543423211000000000096378765743353433000"
    },
    "register": {
      "hash": "1c612b23e1d29246",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "There. Your name is in the register, and this is your identity card. Keep it on you. The police may ask to see it.",
      "chars": 114,
      "chars_total": 92,
      "request_id": "2L67zrEjzajiuANVjGyE",
      "seconds": 8.28,
      "mouth": "4999942211000000000000000038999999997699987797444234321000000267664364477664477334523254444210000000000000429229576665341100000000002651597996344587776753144544554100"
    },
    "board": {
      "hash": "a0e730e38460cc5a",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Now read the town board on the square, right beside me. It shows where everything in town is.",
      "chars": 93,
      "chars_total": 74,
      "request_id": "YDIWO0091i4k2CijXupA",
      "seconds": 9.09,
      "mouth": "79999887511000000100137999954591994899986576644521102997686742586542111000000000157999227744687756644311000000000000000000298367659997445431110058631138968871177666745446676654432100"
    },
    "work_errand": {
      "hash": "540c8d4f54202eb4",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Time to earn your first wages. The post office is down the street. Take courier work at the counter, pick up a parcel, carry it to the drop at the east end of the street, and complete the run.",
      "chars": 192,
      "chars_total": 154,
      "request_id": "fskdUsw08G8cvPKoHEi0",
      "seconds": 13.55,
      "mouth": "44999998437952799997753279652586333433321000000000000351999986387325345523977655512752121100000000000000000389733369988877761362343265423321000000000009923825619689844644511000000000359999997147658329866312136164214896435987645565249732110000000014871397157741583676342000"
    },
    "bank": {
      "hash": "49bc12c0b617dcdc",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "You were paid in cash. Cash in a pocket is lost if you die. Money in the bank is not. Deposit some at the cash machine on the bank wall, next to the post office.",
      "chars": 161,
      "chars_total": 128,
      "request_id": "qzDMfGhXnkaNAeGcpUey",
      "seconds": 14.48,
      "mouth": "56999972799875664347525455641000000000000000000339999664136662199722742114533699985511026432636765434311000000000000000000599999996211357663777624547665222110000000000000000000268119999885244788751112995471378765286454788611139998847776114665552110000000046999823432686729954536442133332100"
    },
    "done": {
      "hash": "be8fea6f4883904c",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Welcome to Everon. Here is something to start you off. The town is yours now. The shops, the car lot, the police station and the organization office are all on the town board.",
      "chars": 175,
      "chars_total": 140,
      "request_id": "cVGlGD2h7JmPPohxy5XC",
      "seconds": 14.45,
      "mouth": "79993378741569996877554421100000000000100001799865499726776412345178644676563332100000000000037145599988622267558988746755541000000001100017787999525654310000000042143999898751311000000000008119879745359755476531366641109999899853865446567324434311111023675999998742113988715388774655533000"
    },
    "idle": {
      "hash": "8fbd0dff9990d788",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "You are settled in. The town board on the square shows the rest: the shops, the car lot, the police station and the organization office.",
      "chars": 136,
      "chars_total": 108,
      "request_id": "yHSFljzvlXhg8ZqzO0Rm",
      "seconds": 11.27,
      "mouth": "3899885549877899997411100000000000000000000000014961998999767649999557765551399984555875356553543212100000000000566759983166442100000002513449999985222100000000056199777352587556751110000001576651119995898657654364442323333000"
    },
    "about_work": {
      "hash": "37f777269aa8b1f1",
      "date": "2026-11-22",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Looking for work? Start with the orchard east of town: pick apples, press the juice, sell it at the market. Then open your player menu with F2 and read What to do next. The town board lists the rest.",
      "chars": 199,
      "chars_total": 162,
      "request_id": "wGRBI5zr2ftgAhzACBep",
      "seconds": 17.9,
      "mouth": ""
    },
    "about_town": {
      "hash": "20a8c59e117188eb",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Everon is a small island. People here know each other, and they remember faces. Stay honest and you will do well.",
      "chars": 113,
      "chars_total": 90,
      "request_id": "iP95LsJi85Qq9ihgm4ll",
      "seconds": 8.58,
      "mouth": "9979999878872111047554664999952676555443111000000000001005982896328888998734453652110047788577887746232865335243211101000000000013440599999766341210002675686787599796545200"
    },
    "bye": {
      "hash": "863a5bab0598b4ed",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Good day to you.",
      "chars": 16,
      "chars_total": 12,
      "request_id": "2vsbUDmnXAOQdftEoGPM",
      "seconds": 0.87,
      "mouth": "894497422545543000"
    },
    "welcome_papers": {
      "hash": "0d13a5152e4fc0be",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Welcome to Everon. First, your papers. Form R-89 is the relocation form, and I will file it under your name. Your identity card comes with it.",
      "chars": 142,
      "chars_total": 57,
      "request_id": "2WJh7RRG1JlHV5mDEEQY",
      "seconds": 11.66,
      "mouth": "999339975887845654531110000000000146999742211596269732654343110000000000013499997212999727958788887664121634767999963376446633465543100000000277897644549999876221279877777776541110000000000000006866439982646136997754132786537735312000"
    },
    "welcome_room": {
      "hash": "c9f193b94b792e7f",
      "date": "2026-11-16",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "You sleep at the hostel tonight. The dormitory is upstairs, and any free bunk is yours. It is plain, but it is warm.",
      "chars": 116,
      "chars_total": 46,
      "request_id": "xXFCcOe7uYfl8E9JYyrH",
      "seconds": 9.8,
      "mouth": "7767559953922964985336334554411110000000000025736999973367664211555633522765443211000000000026531199998634487339974211488646987665331100000000000295743119369997655411100000007775774267999865554200"
    },
    "welcome_town": {
      "hash": "6596d79e95dc8b5f",
      "date": "2026-11-22",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "The town expects honest work and quiet nights. Greet your neighbors, pay what you owe, and ask the police if you are ever lost.",
      "chars": 127,
      "chars_total": 102,
      "request_id": "4nvS8mEEQwQAqzzjYSru",
      "seconds": 9.78,
      "mouth": "4815959999976114714414962331100799999648677412110000255432948876236542123210000000000000001359935498877555542100000000010099799897236678776411000000002688965118369666533325222765754656664434402100"
    },
    "welcome_pack": {
      "hash": "a1ea48bcd5dae7e0",
      "date": "2026-11-22",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "There. Your name is in the register, and this is your identity card. Keep it on you. And here is the welcome pack the town gives every newcomer: bread, a sausage, a bottle of water and some cash to start with.",
      "chars": 209,
      "chars_total": 84,
      "request_id": "TcN9cZqJBgccN7xhi6mE",
      "seconds": 19.56,
      "mouth": ""
    },
    "starter_car": {
      "hash": "9c3af61b0e555f3a",
      "date": "2026-11-22",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Your new car waits at the garage counter of the car lot, next to the town hall: take it out there.",
      "chars": 98,
      "chars_total": 100,
      "request_id": "GUXXqlxqbc2fYNsbr7Ow",
      "seconds": 7.16,
      "mouth": "499999974469997676211001469993336532748899988754232665356641155471333999654111110000000000069963514845146666465443110000000000158427664126331000"
    },
    "apples": {
      "hash": "43b245ad7b3c0fcc",
      "date": "2026-11-22",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Drive to the orchard east of the town and pick six apples from the trees.",
      "chars": 73,
      "chars_total": 60,
      "request_id": "x8wA94p1utwEWCkrK1Mg",
      "seconds": 5.4,
      "mouth": "6999999323947412999246954111100002997439448154436653110000000027618843345796343211398148864389774458653331000"
    },
    "juice": {
      "hash": "adf75c6a275ad7ef",
      "date": "2026-11-22",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Press your six apples into two bottles of juice at the juice press on the orchard stall.",
      "chars": 88,
      "chars_total": 109,
      "request_id": "pe37j1H4FrW4EUHSMZee",
      "seconds": 7.05,
      "mouth": "9996658755589243986145433100486345110548998742111100079997864732359944553111011110000496267234896531598644321167766611119993447335438544321000"
    },
    "market": {
      "hash": "f61512ea5cd5fcc9",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Drive back to the market in the town center and sell your apple juice to the trader. Scroll to the juice row, the last one, and press F.",
      "chars": 136,
      "chars_total": 149,
      "request_id": "o8hhh4Pwb6WWuRrqXknZ",
      "seconds": 11.4,
      "mouth": "499999832998313768899832643136866143368864489836972111000000157555459998751139924963488534146272648855111100000000000000000025651379998886411149375348855379998621110110000057799886436898641110000000002766129997543111376532432100"
    },
    "papers": {
      "hash": "cb6505ef2016a398",
      "date": "2026-11-22",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Your papers. Tell me what you need.",
      "chars": 35,
      "chars_total": 14,
      "request_id": "slX1xBAUJHG0YLoNMFOy",
      "seconds": 2.56,
      "mouth": "4832999447652211000000000000015599899775355554321000"
    },
    "papers_first": {
      "hash": "8bd98c2811e0e494",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Papers first. Tell me you are new in town, and I will write your name in the register.",
      "chars": 86,
      "chars_total": 34,
      "request_id": "mANbmT9kLVi6FJau4mVq",
      "seconds": 5.83,
      "mouth": "994486434533321110000000000000002999999863115898789976613586565411000000005879867758997334978899985157776763433443100"
    },
    "market_done": {
      "hash": "cb23883d6f27b3c9",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "You are on your way. For steady pay, take a job: the town board lists who is hiring, and I have more errands for you. Your errands and jobs are in your player menu.",
      "chars": 164,
      "chars_total": 66,
      "request_id": "qOuyc3sIPgUkuJ34St36",
      "seconds": 12.32,
      "mouth": "5999722999989979654110000000000001337541885641999987311000000000168427333765422111000000005316479999589956765343331103969863337989766411111010001679987987999721578765342454341110000000000066412899998732314665359988763423125767776257687676665432100"
    },
    "settle_parcels": {
      "hash": "3f0e1896aedef271",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Now run five parcels for the post office. Five runs will earn you the level for the fuel run, which comes next.",
      "chars": 111,
      "chars_total": 44,
      "request_id": "xWJoBBtyZZTXMdi2h8cE",
      "seconds": 9.18,
      "mouth": "7778996211110010001699999941111244498995219956648965223385711976947533644421000000001010023399986599999654211005878787775766895998411235444443985565452111101110001736138765374213332100"
    },
    "settle_fuel": {
      "hash": "b7b4748041cfaf54",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Fuel runs are open to you now. Take a jerrycan job from the dispatch board and deliver it.",
      "chars": 90,
      "chars_total": 36,
      "request_id": "B04YSdzJa60Gv51lFBVp",
      "seconds": 6.3,
      "mouth": "3439998799988734411246110998389824477878754431100000000000039953753699872367754898753347664454418854216765331155466574443111000"
    },
    "settle_wheels": {
      "hash": "6cbef3c3b828853d",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Get your driving license at the town hall desk first, then buy any car at the car lot. The town board shows where it is.",
      "chars": 120,
      "chars_total": 48,
      "request_id": "rUct0hwCa6g2ds9BONb7",
      "seconds": 9.54,
      "mouth": "49984993499989877752365322210274271384999878874676431226353310100000000000000589698765111007999833797776411147135135865444312100000000000000000038139399999797764521000035659986567665545222100"
    },
    "settle_permit": {
      "hash": "ac7f223eedda1122",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Apply for a firearm permit at the gun store counter, and collect it when it is ready.",
      "chars": 85,
      "chars_total": 34,
      "request_id": "mYYbLN5RceBoW08ZaSWX",
      "seconds": 5.74,
      "mouth": "8299999987741112466444299999866197775431101375154367644355134543322100000000000499953297861262210007884575378343100"
    },
    "settle_fish": {
      "hash": "26210db0804e5315",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Catch a fish and sell it at the fish counter.",
      "chars": 45,
      "chars_total": 18,
      "request_id": "a0ViGCGrpk6gDEoRfAp6",
      "seconds": 3.08,
      "mouth": "28934544499866753100000000058845599995221264553397512634332100"
    },
    "settle_plot": {
      "hash": "a1ce336186d5399b",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Find a plot for sale and read its sign. It says what the plot costs and how to buy it.",
      "chars": 86,
      "chars_total": 34,
      "request_id": "GiC1JYYGj0r9rBqP3bjE",
      "seconds": 7.45,
      "mouth": "33999766522103551196997333455399875411000266555477575344775543311000000000000029255499997451100017971251997522229997443133211000001555356542776533300"
    },
    "settle_plot_done": {
      "hash": "9897fc94e35c4bd8",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "That is how land is bought here. Save up, and the plot is yours.",
      "chars": 64,
      "chars_total": 26,
      "request_id": "FMOvQkK7pDqSYj0KLXpj",
      "seconds": 4.74,
      "mouth": "49996218744799899997751298545644311000000000000355698869942292100003766614698675447544433311200"
    },
    "settle_foundation": {
      "hash": "02f79f161a546360",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Lay the foundation of your cottage. The general store sells gravel and cement.",
      "chars": 78,
      "chars_total": 31,
      "request_id": "eH7tlM9PpdkdbEnKeyuM",
      "seconds": 5.93,
      "mouth": "68999473389888799676776412755751297444324310000000010100000368459999997552687764432765432128988456521145233565432122100"
    },
    "card_replaced": {
      "hash": "f965c914123652f9",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "Here is your new card, with a new photograph. The old one is void now.",
      "chars": 70,
      "chars_total": 28,
      "request_id": "7OhChV5RTqormaZfDV58",
      "seconds": 5.27,
      "mouth": "7999855667884334999877543100000000475677898435855265353211100000000000255118999934776654227999852655444100"
    },
    "card_still_carried": {
      "hash": "95c253fd5fe807f3",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "You have your card with you. I cannot issue a second one.",
      "chars": 57,
      "chars_total": 23,
      "request_id": "LPnm00qDpW1aWd0bRNlG",
      "seconds": 3.58,
      "mouth": "488999967852359996773256431100000000101683143998727544666446826555644100"
    },
    "card_no_cash": {
      "hash": "48187880f795dfeb",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "A new card costs the fee, in cash. Come back when you have it.",
      "chars": 62,
      "chars_total": 25,
      "request_id": "4ckPJAItzj5azSE0OVDC",
      "seconds": 4.69,
      "mouth": "9999923299988431113299964266332764110000000014852428645345420000000000036999997217766676443200"
    },
    "card_never_issued": {
      "hash": "d65712049bddae02",
      "date": "2026-11-26",
      "voice_id": "NxYVRLlKssuLUMfbtwGR",
      "voice_name": "Julien - Serious",
      "model": "eleven_multilingual_v2",
      "text": "You are not in the register yet. Tell me you are new in town.",
      "chars": 61,
      "chars_total": 24,
