  "lines": {
    "greet": {
      "text": "Come in. Are you hurt?"
    },
    "what": {
      "text": "I patch people up. A bandage stops bleeding. Anything worse, come to me before it gets worse."
    },
    "where": {
      "text": "If you need a bandage and I am not here, the general store keeps dressings by the counter."
    },
    "rumour": {
      "text": "A lot of cuts from the sawmill this month. The men will not wear gloves."
    },
    "bye": {
      "text": "Look after yourself."
    }
  },
  "replies": {
    "what": "What do you do here?",
    "where": "Can you point me somewhere?",
    "rumour": "Heard anything lately?",
    "more": "One more thing.",
    "bye": "Goodbye.",
    "browse": "Show me what you've got."
  }
