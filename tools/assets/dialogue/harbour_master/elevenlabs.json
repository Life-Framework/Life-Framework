      "voice_id": "LifjXiNLcYfyYJD8PCDT",
      "voice_name": "LaRauque - Hoarse, Deep, and Dramatic",
      "model": "eleven_multilingual_v2",
      "text": "Good. Take a crate from the pile by the crane and carry it where the tag says. Then come back for the next one.",
