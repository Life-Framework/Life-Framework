      "date": "2026-11-18",
      "voice_id": "LifjXiNLcYfyYJD8PCDT",
      "voice_name": "LaRauque - Hoarse, Deep, and Dramatic",
      "model": "eleven_multilingual_v2",
      "text": "You, I know. I have a load that must be across before the tide turns. Fast work, better money, and I will want it done on time. Do you want it?",
