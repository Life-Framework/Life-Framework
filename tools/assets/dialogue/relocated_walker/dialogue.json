  "lines": {
    "greet": {
      "text": "Sorry, we have only just come off the bus. Is this Saint-Philippe? They said someone would meet us."
    },
    "about_from": {
      "text": "From near the Zone. They gave us one suitcase each and a paper with an address on it. That is all of it, here."
    },
    "about_help": {
      "text": "Just point us at the town hall, if you would. The clerk is meant to have our names and a key."
    },
    "bye": {
      "text": "Thank you. Thank you, really."
    }
  },
  "replies": {
    "from": "Where have you come from?",
    "help": "Can I help with anything?",
    "bye": "Welcome to town."
  }
