  "lines": {
    "greet": {
      "text": "Officer on duty. Keep your hands where I can see them, and we will get along."
    },
    "what": {
      "text": "I keep the peace and take the reports. Break into a shop or hurt someone and you will see me again."
    },
    "where": {
      "text": "The station is the building behind me. The {town} board on the square lists everything else."
    },
    "rumour": {
      "text": "We have had burglaries along the main street. If you saw anything, tell us. People here remember faces."
    },
    "bye": {
      "text": "Stay out of trouble."
    }
  },
  "replies": {
    "what": "What do you do here?",
    "where": "Can you point me somewhere?",
    "rumour": "Heard anything lately?",
    "more": "One more thing.",
    "bye": "Goodbye.",
    "browse": "Show me what you've got."
  }
