{
  "id": "gendarme_evening",
  "service": "ElevenLabs text-to-speech",
  "lines": {
    "greet": {
      "hash": "5626a6dbf5ef0abe",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "Good evening. I walk the bank and the square at this hour. All quiet so far.",
      "chars": 76,
      "chars_total": 30,
      "request_id": "fvlk7Q5ULyyp9nfRM154",
      "seconds": 4.31,
      "mouth": "696995998775200000799799449688875786854299774475377677520000000599646988454763587652000"
    },
    "town": {
      "hash": "a208db3f3f2e8803",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "Saint-Philippe is calm after six. A few stray dogs, a few late customers at the cafe. I like it that way.",
      "chars": 105,
      "chars_total": 42,
      "request_id": "lj8MZJUFYlrDEchh4vQe",
      "seconds": 7.07,
      "mouth": "4589953999938864498886367644753553100000000000199449972498679885657620000079934998984388716888768449468743887630000000047889965847844677642000"
    },
    "barn": {
      "hash": "05a290dbc7dc4963",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "People talk about the old barn. I have driven by. A locked door is not a crime, and rumor is not evidence.",
      "chars": 106,
      "chars_total": 42,
      "request_id": "4jZyfDep8ZvhhGj3McHY",
      "seconds": 7.01,
      "mouth": "795898359669687359877567866565210000000779996479587787666410000000000001799975334897676488586458766653000000004799999877765884786756555431000"
    },
    "more": {
      "hash": "41d0c7e68a0e3462",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "Ask what you like. I will answer what I can.",
      "chars": 44,
      "chars_total": 18,
      "request_id": "Y2eDp20kYwAGy5UNDIZM",
      "seconds": 2.66,
      "mouth": "988646973699987544300000789899887469778577557755542000"
    },
    "bell": {
      "hash": "a15d390ba65efa84",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "The church bell marks my rounds. Six, nine, midnight. If you hear it, I am somewhere near the bank.",
      "chars": 99,
      "chars_total": 40,
      "request_id": "otuJqCIpuSBWvttwwp2Z",
      "seconds": 7.98,
      "mouth": "4974698653988999575888798676665100000000035596665310000000048988776420000000289948875254100000000000000000000000002975898999974541058877659889878985947766443100"
    },
    "courier": {
      "hash": "c18bf4ee3d11c608",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "The Courier printed Tuesday's robbery. Most of it is right. Do not repeat the rest.",
      "chars": 83,
      "chars_total": 33,
      "request_id": "2mY9FKTJBLRHzF7bzJy2",
      "seconds": 5.31,
      "mouth": "48549999883399769535974876588576765310000000000379964969467668753431000000000000259998359559548776554142000"
    },
    "mine": {
      "hash": "7088e1ebf4d60294",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "The coal workers head home dusty and tired. Quiet men. They give me no trouble.",
      "chars": 79,
      "chars_total": 32,
      "request_id": "jTroNLY6F0ZtEaHExeoO",
      "seconds": 5,
      "mouth": "49349978973775489699876697633676746766664442000000000369995189877731000000003795996899995479576652000"
    },
    "more2": {
      "hash": "a68d1c21e4a40379",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "A few things for visitors, then.",
      "chars": 32,
      "chars_total": 13,
      "request_id": "QJnyCDlqYog1b08bcJ6n",
      "seconds": 1.84,
      "mouth": "9985599727987428759677377654766653100"
    },
    "market": {
      "hash": "89be253e64783f03",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "Keep your cash in your pocket at the market. Pickpockets love a crowd and an open bag.",
      "chars": 86,
      "chars_total": 34,
      "request_id": "bIoqI0LUWj5b6MxqKBkJ",
      "seconds": 4.9,
      "mouth": "498499648875578862585583744778634541320000000000000395259569435997955798856304898998377757653442000"
    },
    "hostel": {
      "hash": "4b411591ebc765de",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "A bed at the hostel costs little. A night on a bench costs more, if I find you there.",
      "chars": 85,
      "chars_total": 34,
      "request_id": "04CHeRyE0ZXQ3RLNPz4K",
      "seconds": 4.84,
      "mouth": "8869969539999744873487535873455420000000000000268999588975977537875298765410354875587667576553100"
    },
    "who": {
      "hash": "5c01920a540eaf38",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "Brigadier Carrel, evening patrol. If you need an officer by day, the station on the square keeps the desk.",
      "chars": 106,
      "chars_total": 42,
      "request_id": "ynNLEqB9Pp2IXuDCAsIO",
      "seconds": 6.82,
      "mouth": "39979869974898977764100000099789875944687653100000000000001774599999988558468587649876531000000024774498577998975279763494439587555342000"
    },
    "again": {
      "hash": "b5361affad1a67f5",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "Anything else, friend? I have a few minutes before the next lap.",
      "chars": 64,
      "chars_total": 26,
      "request_id": "t3EXYBg8ilWwaz92YVpS",
      "seconds": 3.63,
      "mouth": "9899479987643387554320000000000000089998984499999846295585889743576412100"
    },
    "bye": {
      "hash": "101e2b0ed715438b",
      "date": "2026-11-23",
      "voice_id": "MKHH3pSZhHPPzypDhMoU",
      "voice_name": "Mathis - Deep, Smooth and Sophisticated",
      "model": "eleven_multilingual_v2",
      "text": "Good night. Stay out of trouble, and out of the bank after hours.",
      "chars": 65,
      "chars_total": 26,
      "request_id": "JlOObYemdI1mrwF21MrN",
      "seconds": 4.19,
      "mouth": "497599863541000000000001454999949744696787741000048999678588497757644878766554443100"
    }
  },
