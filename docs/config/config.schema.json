              "minPlayerDistance": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 100000
              },
              "maxHealthPercent": {
                "type": "integer",
                "default": 100,
                "minimum": 0,
                "maximum": 100
              },
              "exemptPrefabs": {
                "type": "array",
                "description": "",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "x-class": "LF_CleanupConfig"
    },
