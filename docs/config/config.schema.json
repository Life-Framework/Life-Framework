                  "add",
                  "replace",
                  "patch",
                  "remove"
                ]
              },
              "wantedAdd": {
                "type": "integer",
                "default": 1,
                "minimum": 0,
                "maximum": 5
              },
              "fine": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 1000000
              },
              "sentenceSeconds": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 86400
              },
              "repeatThreshold": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 1000
              },
              "repeatWantedAdd": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 5
              }
            },
            "additionalProperties": false
          }
