{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Framework owner config",
  "description": "The owner's $profile:LifeFramework/config.json. Generated by tools/config/schema.mjs from the config classes' [Attribute] declarations; do not edit by hand.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "default": 1,
      "description": "Owner file schema version. A file without it is version 1."
    },
    "crime": {
      "type": "object",
      "description": "The crime catalog config: Configs/Crime/LF_CrimeCatalog.conf, with the owner's `crime` section layered over it.",
      "properties": {
        "crimes": {
          "type": "object",
          "description": "Records are an object keyed by a stable key. The key is the crime id, a localization key such as #LF-Offence_Robbery; saved crime records use the same string. An id no shipped entry has adds an offence at the end; an existing id changes only the fields given.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "wantedAdd": {
                "type": "integer",
                "default": 1,
                "minimum": 0,
                "maximum": 5
              },
              "fine": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 1000000
              },
              "sentenceSeconds": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 86400
              },
              "repeatThreshold": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 1000
              },
              "repeatWantedAdd": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 5
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "x-class": "LF_CrimeCatalogConfig"
    },
    "jobs": {
      "type": "object",
      "description": "Job pay, job XP and job levels.",
      "properties": {
        "policeDutyPayPerSecond": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 100
        },
        "medicDutyPayPerSecond": {
          "type": "number",
          "default": 0.4,
          "minimum": 0,
          "maximum": 100
        },
        "benefitBalanceThreshold": {
          "type": "integer",
          "default": 500,
          "minimum": 0,
          "maximum": 1000000
        },
        "benefitAmount": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "maximum": 1000000
        },
        "benefitCooldownSeconds": {
          "type": "number",
          "default": 1200,
          "minimum": 0,
          "maximum": 86400
        },
        "jobXpFirstLevel": {
          "type": "integer",
          "default": 500,
          "minimum": 1,
          "maximum": 1000000
        },
        "jobXpLevelGrowth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 10
        },
        "tracks": {
          "type": "object",
          "description": "Records are an object keyed by a stable key. The key is the job id (CIVILIAN, DELIVERY, FARMER, ...). A job no shipped track has adds one, which must set levelThresholds; an existing key changes only the fields given. The level is 1 plus the thresholds a character's XP has reached, so a changed table reaches existing saves.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "levelThresholds": {
                "type": "array",
                "description": "",
                "items": {
                  "type": "integer"
                },
                "default": []
              },
              "dailyXpCap": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 100000000
              }
            },
            "additionalProperties": false
          }
        },
        "xpAwards": {
          "type": "object",
          "description": "Records are an object keyed by a stable key. The key is the action id the game awards (delivery_run, fruit_pick, gather). An action no shipped award has adds one, which must set job; an existing key changes only the fields given.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "job": {
                "type": "string",
                "default": ""
              },
              "xp": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 100000
              },
              "cooldownSeconds": {
                "type": "number",
                "default": 0,
                "minimum": 0,
                "maximum": 86400
              }
            },
            "additionalProperties": false
          }
        },
        "licenceGates": {
          "type": "object",
          "description": "Records are an object keyed by a stable key. The key is a licence name (LF_ELicenseType, e.g. MINER_GOLD). A licence with no row keeps its shipped gate (its family job, its catalog level); a new row must set job and minLevel.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "job": {
                "type": "string",
                "default": ""
              },
              "minLevel": {
                "type": "integer",
                "default": 1,
                "minimum": 1,
                "maximum": 100
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "x-class": "LF_JobsConfig"
    },
    "shops": {
      "type": "object",
      "description": "Price table for the shop system.",
      "properties": {
        "defaultBuyPrice": {
          "type": "integer",
          "description": "Default buy price when no rule matches",
          "default": 50,
          "minimum": 0,
          "maximum": 1000000
        },
        "defaultSellPrice": {
          "type": "integer",
          "description": "Default sell price when no rule matches",
          "default": 25,
          "minimum": 0,
          "maximum": 1000000
        },
        "priceRules": {
          "type": "object",
          "description": "Ordered price rules; later matches override earlier ones. Records are an object keyed by a stable key. The rule's key is a prefab-path substring, or type:<flags>,mode:<mode> to match by arsenal type (mode defaults to 2, any). A key no shipped rule has adds a rule; an existing key changes only the fields given.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "prefab": {
                "type": "string",
                "default": ""
              },
              "buyPrice": {
                "type": "integer",
                "description": "Buy price: what the player pays",
                "default": 100,
                "minimum": 0,
                "maximum": 1000000
              },
              "sellPrice": {
                "type": "integer",
                "description": "Sell price: what the shop pays the player",
                "default": 50,
                "minimum": 0,
                "maximum": 1000000
              },
              "hidden": {
                "type": "boolean",
                "description": "Never offer this item in any shop",
                "default": false
              }
            },
            "additionalProperties": false
          }
        },
        "extraItemPrefabs": {
          "type": "array",
          "description": "Extra item prefabs priced outside the entity catalog",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "x-class": "LF_ShopPricesConfig"
    },
    "vehicles": {
      "type": "object",
      "description": "Vehicle prices.",
      "properties": {
        "buyPercent": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "maximum": 1000
        },
        "sellBackPercent": {
          "type": "integer",
          "default": 50,
          "minimum": 0,
          "maximum": 1000
        },
        "chopPercent": {
          "type": "integer",
          "default": 30,
          "minimum": 0,
          "maximum": 1000
        },
        "chopValueCap": {
          "type": "integer",
          "default": 3000,
          "minimum": 0,
          "maximum": 1000000
        },
        "impoundPercent": {
          "type": "integer",
          "default": 10,
          "minimum": 0,
          "maximum": 1000
        },
        "garagePercent": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 1000
        },
        "vehicles": {
          "type": "object",
          "description": "Records are an object keyed by a stable key. The key is the vehicle's prefab GUID (16 hex digits, the lot's vanilla car or its locked child). A GUID no shipped vehicle has adds one, which must set basePrice. An existing key changes only the fields given; an override of -1 derives the price.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "spawnPrefab": {
                "type": "string",
                "default": ""
              },
              "basePrice": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 1000000
              },
              "buyOverride": {
                "type": "integer",
                "default": -1,
                "minimum": -1,
                "maximum": 1000000
              },
              "sellBackOverride": {
                "type": "integer",
                "default": -1,
                "minimum": -1,
                "maximum": 1000000
              },
              "chopOverride": {
                "type": "integer",
                "default": -1,
                "minimum": -1,
                "maximum": 1000000
              },
              "impoundOverride": {
                "type": "integer",
                "default": -1,
                "minimum": -1,
                "maximum": 1000000
              },
              "garageOverride": {
                "type": "integer",
                "default": -1,
                "minimum": -1,
                "maximum": 1000000
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "x-class": "LF_VehiclePricesConfig"
    },
    "wantedBoard": {
      "type": "object",
      "description": "The posters drawn on the wanted board's face (docs/architecture/visual-boards-budget.md): Configs/Police/LF_WantedPosters.conf with the owner's `wantedBoard` section layered over it.",
      "properties": {
        "posters": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 8
        },
        "stolenPosters": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 8
        },
        "drawRadius": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "x-class": "LF_WantedPostersConfig"
    }
  },
  "additionalProperties": false
}
